{
  "name": "solid-optimistic-loop-repro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "repro": "node --conditions=development src/node.ts same; node --conditions=development src/node.ts split",
    "repro:prod": "node src/node.ts same; node src/node.ts split"
  },
  "dependencies": {
    "@solidjs/signals": "2.0.0-rc.14",
    "@solidjs/web": "2.0.0-rc.14",
    "solid-js": "2.0.0-rc.14"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.49",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
